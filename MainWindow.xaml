<Window x:Class="FocusBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusBar.Controls"
        Icon="/icon.ico"
        Title="FocusBar" Width="320" SizeToContent="Height"
        Topmost="True" WindowStyle="None" ResizeMode="NoResize"
        Background="#FAFAF7" BorderBrush="#D0D0C8" BorderThickness="1"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#555" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- 할 일 한 줄: ○/● 체크 · 제목 · 마감 · ▶ 타이머 (오늘/장기 공용) -->
        <DataTemplate x:Key="TaskRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="{Binding DoneMark}" ToolTip="체크 (Notion에 반영)"
                        Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <!-- 영역 배지: Notion 옵션 색 그대로 -->
                <Border Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="2,0,0,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{Binding CategoryBackground}"
                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Category}" Foreground="{Binding CategoryForeground}"
                               FontSize="11" MaxWidth="64" TextTrimming="CharacterEllipsis" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="4,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Foreground" Value="#AAA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding DueText}" Margin="4,0"
                           VerticalAlignment="Center" Foreground="#999" />
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="▶" ToolTip="타이머 시작"
                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <StackPanel>
        <!-- 헤더: 드래그로 창 이동 -->
        <Grid Background="#EFEFE8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FocusBar" Margin="10,0" VerticalAlignment="Center" Foreground="#777" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="새로고침"
                        Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource IconButton}" Content="▭" ToolTip="미니 모드"
                        Command="{Binding ToggleMiniCommand}" />
                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="📌"
                        ToolTip="항상 위 켜기/끄기" Click="Pin_Click" />
                <Button Style="{StaticResource IconButton}" Content="—" ToolTip="최소화" Click="Minimize_Click" />
                <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="닫기" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- 타이머 -->
        <Border Padding="10" BorderBrush="#E0E0D8" BorderThickness="0,0,0,1"
                Visibility="{Binding IsTimerVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:TimerDial Width="{Binding DialSize}" Height="{Binding DialSize}"
                                        Fraction="{Binding DialFraction}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RemainingText}" FontSize="22" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource ActionButton}" Content="끝" Command="{Binding FinishDoneCommand}" />
                    <Button Style="{StaticResource ActionButton}" Content="{Binding ExtendLabel}" Command="{Binding ExtendCommand}" />
                    <Button Style="{StaticResource ActionButton}" Content="중단" Command="{Binding StopCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 오늘 + 장기 (미니 모드에서는 숨김) -->
        <StackPanel Margin="10,8,10,10" Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVis}}">

            <TextBlock Text="{Binding TodayHeader}" Style="{StaticResource SectionHeader}" />
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TodayTasks}" ItemTemplate="{StaticResource TaskRow}" Grid.IsSharedSizeScope="True" />
            </ScrollViewer>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                         ToolTip="오늘 할 일 입력 후 Enter → Notion에 오늘 날짜로 추가">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox Grid.Column="1" Width="36" Margin="6,0,2,0" Padding="0,3"
                         HorizontalContentAlignment="Center" ToolTip="타이머 길이(분)"
                         Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="분" VerticalAlignment="Center" />
            </Grid>

            <Expander Margin="0,10,0,0" IsExpanded="False" Header="{Binding LongTermHeader}"
                      Foreground="#888" Visibility="{Binding HasLongTerm, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding LongTermTasks}" ItemTemplate="{StaticResource TaskRow}" Grid.IsSharedSizeScope="True"
                                  Foreground="Black" />
                </ScrollViewer>
            </Expander>

            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" FontSize="11"
                       Foreground="#888" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</Window>
